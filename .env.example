# Copy to .env and adjust. Safe local defaults, no secrets.
# Values used by llmtrano.settings.Settings.

# OpenAI-compatible endpoint served by llama-swap (inside compose: http://llm:8080/v1)
LLM_BASE_URL=http://localhost:8080/v1
LLM_DEFAULT_MODEL=qwen3.5-9b
LLM_INTERPRET_MODEL=qwen3.6-35b-a3b

# Postgres (inside compose: host "db"). Local-only credentials; DATABASE_URL must match them.
POSTGRES_USER=llmtrano
POSTGRES_PASSWORD=llmtrano
POSTGRES_DB=llmtrano
DATABASE_URL=postgresql+psycopg://llmtrano:llmtrano@localhost:5432/llmtrano

# Valkey speaks the Redis protocol (inside compose: host "queue")
VALKEY_URL=redis://localhost:6379/0

# Models downloaded by the model-fetch service (pinned Hugging Face commits, see docs/decisions.md)
MODEL_9B_REPO=bartowski/Qwen_Qwen3.5-9B-GGUF
MODEL_9B_FILE=*Q4_K_M*.gguf
MODEL_9B_REVISION=182be2fd6c7bc44887d88a91cb03ff009cc9f549
MODEL_MOE_REPO=bartowski/Qwen_Qwen3.6-35B-A3B-GGUF
MODEL_MOE_FILE=*Q4_K_M*.gguf
MODEL_MOE_REVISION=5c2410d71524f4f72b023ce8daf7a80528226d5f

# Simulation
RUNS_DIR=runs
SIMULATION_LIBRARY=Buildings
SIMULATION_TIMEOUT_S=1200
